Q5. Find Sum of Digits of a Number
#include<stdio.h>

int main()
{
    int n, digit, sum = 0;

    printf("Enter a number: ");
    scanf("%d", &n);

    while(n != 0)
    {
        digit = n % 10;
        sum = sum + digit;
        n = n / 10;
    }

    printf("Sum of digits = %d", sum);

    return 0;
}
Sample Output
Enter a number: 1234
Sum of digits = 10


Q6. Reverse a Number
#include<stdio.h>

int main()
{
    int n, digit, reverse = 0;

    printf("Enter a number: ");
    scanf("%d", &n);

    while(n != 0)
    {
        digit = n % 10;
        reverse = reverse * 10 + digit;
        n = n / 10;
    }

    printf("Reversed number = %d", reverse);

    return 0;
}
Sample Output
Enter a number: 1234
Reversed number = 4321


